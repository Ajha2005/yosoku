108430,24YrEAGF32M,UgwexeSv5aBp4RgRZy14AaABAg,2022-06-23T23:24:27Z,0,0,"Public Class Form1
    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load

    End Sub

    Private Sub Button2_Click(sender As Object, e As EventArgs) Handles Button2.Click
        TextBox1.Text = """"
        TextBox2.Text = """"
        ComboBox1.SelectedIndex = -1
        RadioButton1.Checked = """"
        RadioButton2.Checked = """"
        CheckBox1.Checked = False
        CheckBox2.Checked = False
        MessageBox.Show(""Reset"")

    End Sub

    Private Sub TextBox1_TextChanged(sender As Object, e As EventArgs) Handles TextBox1.TextChanged

    End Sub

    Private Sub Button1_Click(sender As Object, e As EventArgs) Handles Button1.Click
        Dim strName As String
        Dim strMobile As String
        Dim strComboBox As String
        Dim strRB1 As String
        Dim CB1 As String
        Dim CB2 As String

        strName = TextBox1.Text.Insert(0, """")
        strMobile = TextBox2.Text.Insert(0, """")

        strComboBox = ComboBox1.Text.Insert(0, """")

        If (RadioButton1.Checked) Then
            strRB1 = RadioButton1.Text.Insert(0, """")
        End If

        If (RadioButton2.Checked) Then
            strRB1 = RadioButton2.Text.Insert(0, """")
        End If

        If (CheckBox1.Checked) Then
            CB1 = CheckBox1.Text.Insert(0, """")
        End If

        If (CheckBox2.Checked) Then
            CB2 = CheckBox2.Text.Insert(0, """")
        End If

        RichTextBox1.Text = ""---------------------------------"" & vbNewLine &
            vbNewLine & ""Name: "" & strName &
            vbNewLine & ""Mobile: "" & strMobile &
            vbNewLine & ""ComboBox: "" & strComboBox &
            vbNewLine & ""RB: "" & strRB1 &
            vbNewLine & CB1 &
            vbNewLine & CB2 & vbNewLine

        MessageBox.Show(""Comfirm Order"")
    End Sub

    Private Sub Button3_Click(sender As Object, e As EventArgs) Handles Button3.Click
        Dim f2 As New Form2(Me)
        f2.ShowDialog()
    End Sub
End Class

form 2"
